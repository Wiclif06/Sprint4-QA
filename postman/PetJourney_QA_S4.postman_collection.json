      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "const d=pm.response.json(); pm.test('Token de Ana presente',()=>pm.expect(d.token).to.be.a('string').and.not.empty); pm.environment.set('tokenAna',d.token);"
